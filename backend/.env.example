# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server
PORT=3000
NODE_ENV=development

# Logging (DGO-17) — nivel de pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Metrics (DGO-17) — si se define, GET /api/metrics exige ?key=<METRICS_KEY>
METRICS_KEY=

# API Docs (DGO-18) — en producción, GET /api/docs exige ?key=<DOCS_KEY>
DOCS_KEY=

# URL pública del backend (para el "servers" de la doc Swagger). Opcional:
# si no se define, se usa la URL de producción en Railway ya conocida.
PUBLIC_API_URL=

# CORS — orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

CRON_SECRET=un-string-largo-y-aleatorio-para-la-seguridad
PHOTON_APP_ID=tu_photon_app_id
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LIVEKIT_API_KEY=tu_livekit_key
LIVEKIT_API_SECRET=tu_livekit_secret
LIVEKIT_URL=wss://tu-livekit.livekit.cloud
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=tu_token
LIVEBLOCKS_SECRET_KEY=sk_...
JWT_SECRET=un_string_largo_aleatorio_minimo_32_chars


# LiveKit Cloud (DGO-13)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=