# ==========================================
# UNITY
# ==========================================

# Carpetas generadas (en cualquier subdirectorio)
**/Library/
**/Temp/
**/Logs/
**/Obj/
# Solo builds del proyecto Unity — NO ignorar web-client/public/unity-build/Build/
# (ese path se publica en Vercel con el WebGL embebido).
unity-client/**/Build/
unity-client/**/Builds/
**/UserSettings/
**/.vs/

# Plastic SCM (control de versiones interno de Unity)
**/.plastic/
**/*.plastic.changes
**/*.plastic.selector
**/*.plastic.wktree
**/*.plastic.workspace

# VS Code (proyecto Unity)
**/.vscode/
**/*.code-workspace

# Archivos de compilación
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.csproj
*.unityproj
*.sln

# Builds
*.apk
*.aab
*.unitypackage
*.tmp
sysinfo.txt
crashlytics-build.properties

# ==========================================
# NODE / WEB
# ==========================================

node_modules/
# Bloquea cualquier variante de .env (incluye backups como .env.bak,
# .env.old, .env.development, etc.) — solo se permite .env.example.
.env*
!.env.example
dist/
.next/
.cache/
.turbo/
*.tsbuildinfo

# ==========================================
# GENERAL
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini
*.log
*.orig
*.swp
.idea/
.vercel
